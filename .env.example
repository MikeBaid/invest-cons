# Только read-only API доступ
INVEST_TOKEN_READ=
INVEST_CLIENT_LABELS=Mike,Marina
FREEDOM_TRADERNET_PUBLIC_KEY=
FREEDOM_TRADERNET_PRIVATE_KEY=
FREEDOM_TRADERNET_DOMAIN=freedom24.com
FREEDOM_CLIENT_LABEL=Freedom

# Каждый Telegram user ID сейчас видит все счета, указанные в конфигурации.
# Используйте отдельного бота, не token прежнего проекта.
PORTFOLIO_V2_TELEGRAM_TOKEN=
PORTFOLIO_V2_TELEGRAM_IDS=
PORTFOLIO_V2_OWNER_MAP={"Mike":"owner_mike","Marina":"owner_marina","Freedom":"owner_mike"}
# PORTFOLIO_V2_EXCLUDE_ACCOUNTS=

# Отдельная база данных и порт, не связанные с прежним проектом.
POSTGRES_DB=invest_cons
POSTGRES_USER=invest_cons
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://invest_cons:change-this-local-password@localhost:5434/invest_cons

# Дополнительные корни только для gRPC процесса, не для Windows.
# TINVEST_GRPC_EXTRA_ROOT_CERTS=C:\path\to\root.pem;C:\path\to\sub_ca.pem
# TINVEST_GRPC_ROOTS_BUNDLE_PATH=data\certs\tinvest_grpc_roots_bundle.pem
